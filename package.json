{
  "name": "pokemon-champions-drafter",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Browser-based drafting tool for Pokemon Champions draft tournaments",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && vite build",
    "build:roster": "node scripts/build-roster.mjs",
    "build:sprites": "node scripts/build-sprites.mjs",
    "build:data": "npm run build:roster mb && npm run build:roster ma && npm run build:sprites",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:pure": "node scripts/check-pure-core.mjs src/core",
    "check:nohtml": "node scripts/check-pure-core.mjs --nohtml src",
    "check:pure:selftest": "node scripts/check-pure-core-selftest.mjs",
    "verify": "npm run check:pure && npm run check:nohtml && npm run test && npm run build"
  },
  "dependencies": {
    "@preact/signals": "2.10.1",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/node": "^24.0.0",
    "happy-dom": "^20.11.1",
    "pokemon-showdown": "0.11.11",
    "typescript": "~5.9",
    "vite": "8.2.0",
    "vitest": "^4.1.10"
  }
}
